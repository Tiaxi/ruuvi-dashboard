# Ruuvi Dashboard configuration
# Copy this file to .env and customize as needed.
# Values shown are the defaults, except GF_ADMIN_PASSWORD, which you must set.

# Grafana admin password (required; Compose refuses to start without it).
# Only used on the first start, when Grafana creates its admin user. To change
# it later, see "Grafana admin password" in the README. Keep the value in
# single quotes, e.g. GF_ADMIN_PASSWORD='my password', so a "$" stays literal.
# Write an apostrophe inside the value as \'.
GF_ADMIN_PASSWORD=

# Dashboard title (used in Grafana tab and dashboard header)
DASHBOARD_TITLE=Ruuvi Dashboard

# --- Grafana address and security ---
# The defaults suit plain HTTP on a home network: open http://<host>:3000 from
# any computer on the LAN.
#
# Public Grafana URL as seen by browsers. Grafana uses it for links it
# generates (e.g. share links). On a LAN, set it to the address you open,
# e.g. http://raspberrypi.local:3000/. For a reverse proxy, set it to the
# external HTTPS URL, e.g. https://saa.example.com/.
GRAFANA_ROOT_URL=http://localhost:3000/

# Public Grafana hostname, e.g. saa.example.com. Only enforced when
# GRAFANA_ENFORCE_DOMAIN=true.
GRAFANA_DOMAIN=localhost

# Serve Grafana under a subpath (e.g. /grafana/) for reverse proxy setups.
# Leave empty for root path. If set, include leading and trailing slashes and
# include the same path in GRAFANA_ROOT_URL.
GRAFANA_SUBPATH=

# HTTPS / reverse-proxy profile: when Grafana is served over HTTPS at a fixed
# hostname, set both to true (together with GRAFANA_ROOT_URL and
# GRAFANA_DOMAIN above).
# - GRAFANA_ENFORCE_DOMAIN=true redirects requests for any other hostname to
#   GRAFANA_DOMAIN. Leave false on a LAN, or browsers that open Grafana by IP
#   or hostname get redirected to their own localhost.
# - GRAFANA_COOKIE_SECURE=true sends the login cookie over HTTPS only. Leave
#   false for plain HTTP, or logging in fails from other computers.
GRAFANA_ENFORCE_DOMAIN=false
GRAFANA_COOKIE_SECURE=false

# Admin UI host port (collector listens on 8000 inside container)
ADMIN_PORT=8000

# Grafana host port
GRAFANA_PORT=3000

# VictoriaMetrics data retention period
VM_RETENTION=1y
